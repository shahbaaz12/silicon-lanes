worker_processes auto;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events { worker_connections 1024; }

stream {
  log_format advanced_edge_l4 '[advanced-edge-l4] $time_iso8601 client=$remote_addr:$remote_port gateway=$upstream_addr status=$status';
  access_log /dev/stdout advanced_edge_l4;

  upstream api_gateway_pool {
    zone api_gateway_pool 64k;
    server ${GATEWAY_1};
    server ${GATEWAY_2};
  }

  server {
    listen 80;
    proxy_pass api_gateway_pool;
    proxy_connect_timeout 1s;
    # Keep the teaching log observable; production timeouts are workload-specific.
    proxy_timeout 3s;
  }
}
