map $http_origin $lesson_cors_origin {
  default "";
  "http://localhost:7012" $http_origin;
  "http://127.0.0.1:7012" $http_origin;
}

log_format hybrid_gateway '[hybrid-gw] $time_iso8601 $request_method $uri $status service=$upstream_http_x_service_name server=$upstream_http_x_request_server';

upstream user_service { server ${USER_UPSTREAM}; }
upstream order_service { server ${ORDER_UPSTREAM}; }
upstream catalog_load_balancer { server ${CATALOG_LB_UPSTREAM}; }

server {
  listen 80;
  access_log /dev/stdout hybrid_gateway;
  error_log /dev/stderr warn;

  location = /hybrid-gateway-health { access_log off; return 200 'ok'; }

  location = /api/users { proxy_pass http://user_service; include /etc/nginx/hybrid_proxy_params; }
  location = /api/orders { proxy_pass http://order_service; include /etc/nginx/hybrid_proxy_params; }
  location = /api/products { proxy_pass http://catalog_load_balancer; include /etc/nginx/hybrid_proxy_params; }
}
